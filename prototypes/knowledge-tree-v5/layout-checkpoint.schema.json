{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V5.2 prototype presentation checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layout_schema_version",
    "layout_algorithm_version",
    "generation",
    "reserve",
    "gap",
    "level",
    "categories"
  ],
  "properties": {
    "layout_schema_version": {
      "const": 2
    },
    "layout_algorithm_version": {
      "const": "persistent-geography-2"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "reserve": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "gap": {
      "const": 32
    },
    "level": {
      "const": 900
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^category:[0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id",
          "parent_id",
          "sibling_order",
          "anchor",
          "width",
          "reserved_capacity",
          "topicStart",
          "topicRowOffset",
          "children",
          "growth_limit_width"
        ],
        "properties": {
          "category_id": {
            "type": "string",
            "pattern": "^category:[0-9]+$"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^category:[0-9]+$"
          },
          "sibling_order": {
            "type": "integer",
            "minimum": 0
          },
          "anchor": {
            "type": "number",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reserved_capacity": {
            "type": "number",
            "minimum": 0
          },
          "topicStart": {
            "type": "number",
            "minimum": 0
          },
          "topicRowOffset": {
            "type": "integer",
            "enum": [
              0,
              2
            ]
          },
          "children": {
            "type": "object",
            "propertyNames": {
              "pattern": "^category:[0-9]+$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "left",
                "width"
              ],
              "properties": {
                "left": {
                  "type": "number",
                  "minimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "growth_limit_width": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
