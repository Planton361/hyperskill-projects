{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Atlas presentation activation history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "history_version",
    "layout_generation",
    "active_categories",
    "active_topics",
    "geometry_hashes",
    "accepted_geometry",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "history_version": {
      "type": "integer",
      "minimum": 0
    },
    "layout_generation": {
      "type": "integer",
      "minimum": 0
    },
    "active_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^category:[1-9][0-9]*$"
      }
    },
    "active_topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^topic:[1-9][0-9]*$"
      }
    },
    "geometry_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "bounds",
        "connectors"
      ],
      "properties": {
        "geometry": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bounds": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "connectors": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "accepted_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "trays",
        "branches",
        "connectorSegments",
        "buses",
        "bounds"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height",
              "depth",
              "font",
              "line",
              "key",
              "lines"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "depth": {
                "type": "number"
              },
              "font": {
                "type": "number"
              },
              "line": {
                "type": "number"
              },
              "key": {
                "type": "string"
              },
              "parent": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "trays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height",
              "parent",
              "topics"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "parent": {
                "type": "string"
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parent",
              "child",
              "d",
              "points"
            ],
            "properties": {
              "parent": {
                "type": "string"
              },
              "child": {
                "type": "string"
              },
              "d": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "connectorSegments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parent",
              "children",
              "depth",
              "d",
              "points"
            ],
            "properties": {
              "parent": {
                "type": "string"
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "depth": {
                "type": "number"
              },
              "d": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "buses": {
          "type": "array"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x0",
            "x1",
            "y0",
            "y1"
          ],
          "properties": {
            "x0": {
              "type": "number"
            },
            "x1": {
              "type": "number"
            },
            "y0": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            }
          }
        },
        "activationRoutes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parent",
              "child",
              "length",
              "points",
              "shared_frozen_segments"
            ],
            "properties": {
              "parent": {
                "type": "string"
              },
              "child": {
                "type": "string"
              },
              "length": {
                "type": "number"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              },
              "shared_frozen_segments": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest_fingerprint",
          "plan_fingerprint",
          "candidate_fingerprint",
          "variant",
          "generation"
        ],
        "properties": {
          "manifest_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "plan_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "candidate_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "variant": {
            "enum": [
              "current",
              "parent-distance",
              "centering",
              "connector",
              "balanced"
            ]
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
