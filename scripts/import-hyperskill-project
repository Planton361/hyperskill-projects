#!/usr/bin/env python3
"""Byte-preserving import of reviewed owner code; never execute it."""
import argparse
from datetime import datetime, timezone
import fcntl
import hashlib
import json
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile
from archive_selection import inventory, excluded, title_from_source, identity, select, fingerprint
from source_adapters import workspace
from export_metadata import SECRETS, validate_universal_export, unique_object

REPO = Path(__file__).resolve().parents[1]
MANIFEST = '.hyperskill-import.json'


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def git(*args):
    return subprocess.run(['git', '--literal-pathspecs', '-C', str(REPO), *args],
                          check=True, capture_output=True, text=True)


def duplicate_check(root, pid):
    validator = runpy.run_path(str(Path(__file__).with_name('validate-project-exports.py')))
    if any(row['project_id'] == pid for row in validator['validate'](root, allow_empty=True)):
        raise ValueError('Duplicate Project ID already archived; no new publication')
    for marker in [*root.glob('java/*/.hyperskill-import.json'),
                   *root.glob('python/*/.hyperskill-import.json'),
                   *root.glob('projects/*/.hyperskill-import.json')]:
        if marker.is_symlink() or any(p.is_symlink() for p in marker.parents):
            raise ValueError('Symlink existing archive refused')
        meta = json.loads(marker.read_text(encoding='utf-8'), object_pairs_hook=unique_object)
        ids = {meta.get('project_id'), meta.get('completion', {}).get('project_id')}
        if pid in ids:
            raise ValueError('Duplicate Project ID in existing local archive')


def prepare(args):
    source = workspace(args.source, explicit=bool(args.files_from))
    if not source.is_dir() or source == REPO or source.is_relative_to(REPO) or REPO.is_relative_to(source):
        raise ValueError('Source workspace and archive repository must be separate directories')
    pid, url = identity(source, args.project_url)
    title = title_from_source(source, args.title)
    payload = select(source, title, args.files_from)
    confirmed = args.confirmed_at
    if not confirmed:
        if not args.dry_run:
            raise ValueError('Owner confirmation timestamp required; use publish-hyperskill-project')
        confirmed = datetime.now(timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')
    completion = dict(project_id=pid, status='completed', attested_by='owner', confirmed_at=confirmed)
    if args.completed_at is not None:
        completion['completed_at'] = args.completed_at
    readme = (f'# {title}\n\nOwner-selected Hyperskill code archive.\n\n'
              f'Project: {url}\n\nFiles are archived as source; no build or execution is required.\n').encode('utf-8')
    payload['README.md'] = (readme, 'resource')
    manifest = dict(schema=4, mode='code-archive', project_id=pid, project_url=url,
                    title=title, completion=completion, files=fingerprint(payload))
    if args.language:
        manifest['languages'] = args.language
    payload[MANIFEST] = ((json.dumps(manifest, indent=2, ensure_ascii=False) + '\n').encode('utf-8'), 'metadata')
    return source, manifest, payload


def materialize(target, payload):
    for name, (raw, role) in payload.items():
        path = target / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(raw)


def execute(args):
    source, manifest, payload = prepare(args)
    pid = manifest['project_id']
    target = REPO / 'projects' / str(pid)
    if any(p.is_symlink() for p in (target, *target.parents)):
        raise ValueError('Symlink export destination refused')
    if git('rev-parse', '--show-toplevel').stdout.strip() != str(REPO):
        raise ValueError('Importer must run inside archive repository')
    duplicate_check(REPO, pid)
    if target.exists():
        raise ValueError('Destination already exists; manual review required')
    with tempfile.TemporaryDirectory(prefix='hyperskill-schema4-review-') as folder:
        stage = Path(folder).resolve() / str(pid)
        materialize(stage, payload)
        validate_universal_export(stage, manifest)
    print(f'Project ID: {pid}; URL: {manifest["project_url"]}; title: {manifest["title"]!r}')
    print(f'Owner confirmation: {manifest["completion"]["confirmed_at"]}' + (' (preview only)' if args.dry_run else ''))
    print('Actual completion: ' + manifest['completion'].get('completed_at', 'unknown; omitted'))
    print('Target: ' + str(target))
    for name, (raw, role) in sorted(payload.items()):
        print(f'EXPORT {name}; role {role}; {len(raw)} bytes; sha256 {digest(raw)}')
    if args.dry_run:
        print('DRY-RUN OK: no archive files written; no Academy build or solution code was executed.')
        return
    with (REPO / '.import-hyperskill.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        duplicate_check(REPO, pid)
        if target.exists():
            raise ValueError('Destination appeared during import')
        target.parent.mkdir(exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='.import-', dir=target.parent) as folder:
            stage = Path(folder) / str(pid)
            materialize(stage, payload)
            validate_universal_export(stage, manifest)
            stage.rename(target)
    print('IMPORT OK: schema-4 archive written; no build or imported code executed.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('source')
    parser.add_argument('--repository', type=Path)
    parser.add_argument('--files-from', type=Path)
    parser.add_argument('--project-url')
    parser.add_argument('--title')
    parser.add_argument('--language', action='append', help='optional descriptive metadata; repeatable')
    parser.add_argument('--confirmed-at', help='internal owner confirmation UTC instant; publisher records it')
    parser.add_argument('--completed-at', help='optional known actual completion UTC instant')
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    global REPO
    try:
        if args.repository:
            REPO = args.repository.resolve(strict=True)
        execute(args)
    except (ValueError, OSError, subprocess.CalledProcessError, KeyError, TypeError) as error:
        print('STOP: ' + str(error), file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
