#!/usr/bin/env python3
"""Read-only Academy source -> owner-attested source-only project archive."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.parse import urlsplit

from source_adapters import detect, project_url, source_only_files, unsafe_source_path, workspace
from export_metadata import validate_completion, validate_source_only_export

REPO = Path(__file__).resolve().parent.parent
MANIFEST = '.hyperskill-import.json'
BLOCKED = {'.git', '.idea', '.vscode', '.settings', '.metadata', '.fleet', '.run',
           '.gradle', '.m2', '.cache', '.venv', '.pytest_cache', '.mypy_cache',
           '.ruff_cache', 'venv', 'node_modules', 'build', 'target', 'out', 'dist',
           'coverage', 'generated', 'generated-sources', 'generated-test-sources',
           'frameworkLessonHistory', '.hyperskill', '.education', '__pycache__'}
SECRETS = re.compile(
    r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|'
    r'\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[A-Z0-9]{16})\b|'
    r'(?i:(?:password|passwd|api[_-]?key|access[_-]?token|secret)\s*[=:]\s*["\'][^"\'\n]{4,}["\'])'
)
SOURCE_SUFFIXES = {'java': {'.java'}, 'python': {'.py'}}
RESOURCE_SUFFIXES = {'.txt', '.json', '.csv'}


def fail(message):
    raise ValueError(message)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def inventory(root):
    """List all workspace paths without following symlinks."""
    entries = []

    def fail_walk(error):
        raise error

    for parent, dirs, files in os.walk(root, followlinks=False, onerror=fail_walk):
        dirs.sort()
        files.sort()
        entries.extend((Path(parent) / name).relative_to(root) for name in dirs + files)
    return sorted(entries)


def excluded(path):
    if any(part in BLOCKED or part.startswith('.author_contents_storage_db') for part in path.parts):
        return 'IDE/Git/Build/Cache/History'
    name = path.name
    if name == 'task.html' or name.endswith('-info.yaml'):
        return 'Hyperskill metadata/task statement'
    if name.endswith(('.tmp', '.swp', '.bak', '.log', '.class', '.pyc', '.pyo', '~')):
        return 'temporary/generated file'
    if 'test' in path.parts or 'tests' in path.parts:
        return 'tests'
    if re.search(r'(?i)(?:^|[_-])tests?(?:[_-]|\.)', name):
        return 'tests'
    return None


def git(*args, capture=True):
    result = subprocess.run(['git', '--literal-pathspecs', '-C', str(REPO), *args],
                            check=True, text=True, capture_output=capture,
                            env=dict(os.environ, GIT_OPTIONAL_LOCKS='0'))
    return result


def title_from_source(source, override=None):
    if override:
        return override
    course = source / 'course-info.yaml'
    if not course.is_file() or course.is_symlink():
        fail('Project title cannot be read from course-info.yaml; supply --title.')
    matches = re.findall(r'(?m)^title:\s*(.*?)\s*$', course.read_text(encoding='utf-8'))
    if len(matches) != 1:
        fail('A unique title in course-info.yaml is required; supply --title.')
    value = matches[0]
    try:
        if value.startswith('"'):
            title = json.loads(value)
        elif value.startswith("'"):
            if not value.endswith("'"):
                fail('Invalid YAML project title; supply --title.')
            title = value[1:-1].replace("''", "'")
        else:
            title = re.split(r'\s+#', value, maxsplit=1)[0].strip()
    except (json.JSONDecodeError, TypeError):
        fail('Invalid project title; supply --title.')
    if not isinstance(title, str) or not title.strip():
        fail('A non-empty project title is required; supply --title.')
    return title


def safe_directory_name(title):
    """Preserve normal titles and visibly replace path separators."""
    safe = ''.join('／' if ch == '/' else '＼' if ch == '\\' else ch for ch in title)
    if safe in ('', '.', '..') or len(safe.encode('utf-8')) > 240 or unsafe_source_path(Path(safe)):
        fail('Project title does not produce a safe cross-platform directory name.')
    if safe != title:
        print(f'NOTE: replaced path separator in export folder name ({title!r} -> {safe!r}).')
    return safe


def validate_payload(payload, language):
    source_count = 0
    for name, raw in payload.items():
        path = Path(name)
        if path.is_absolute() or path.as_posix() != name or '..' in path.parts or unsafe_source_path(path):
            fail('Unsafe export path: ' + name)
        if len(path.parts) < 2 or path.parts[0] != 'src' or any(part.startswith('.') for part in path.parts):
            fail('Source-only exports must stay below src/ and contain no hidden paths.')
        if path.suffix.lower() in SOURCE_SUFFIXES[language]:
            source_count += 1
        elif path.suffix.lower() not in RESOURCE_SUFFIXES:
            fail('Unsupported source-only archive file: ' + name)
        try:
            text = raw.decode('utf-8')
        except UnicodeDecodeError:
            fail('Source-only archive members must be UTF-8 text: ' + name)
        if SECRETS.search(text):
            fail('Possible secret in export member (contents withheld): ' + name)
    if not source_count:
        fail('Source-only export requires at least one final solution file.')


def execute(args):
    source = workspace(args.source)
    if not source.is_dir() or source == REPO or source.is_relative_to(REPO) or REPO.is_relative_to(source):
        fail('Academy workspace and publisher repository must be separate directories.')
    language = detect(source, args.language)
    title = title_from_source(source, args.title)
    if len(title) > 200 or any(ord(char) < 32 or ord(char) == 127 for char in title):
        fail('Project title contains unsupported characters or exceeds 200 characters.')
    directory_name = safe_directory_name(title)
    target = REPO / language / directory_name
    if any(p.is_symlink() for p in (target.parent, target)):
        fail('Export destination may not traverse a symlink.')
    if git('rev-parse', '--show-toplevel').stdout.strip() != str(REPO.resolve()):
        fail('Importer must run inside the publisher repository.')
    url = project_url(source, args.project_url)
    parsed = urlsplit(url)
    if (parsed.scheme != 'https' or parsed.netloc != 'hyperskill.org' or
            not re.fullmatch(r'/projects/[1-9][0-9]*/', parsed.path + ('/' if not parsed.path.endswith('/') else '')) or
            parsed.query or parsed.fragment):
        fail('Project URL must be the exact https://hyperskill.org/projects/ID URL.')
    pid = int(parsed.path.rstrip('/').split('/')[-1])
    if not args.completed_at:
        fail('Actual owner completion timestamp is required; it is never generated.')
    completion = validate_completion(dict(project_id=pid, status='completed', attested_by='owner',
                                          observed_at=args.completed_at))
    if target.exists():
        fail('Destination already exists; duplicate project exports require manual review.')
    if git('ls-tree', 'HEAD', '--', target.relative_to(REPO).as_posix()).stdout:
        fail('Destination exists in committed Git; duplicate project exports require manual review.')

    academy_paths = inventory(source)
    code_root, payload = source_only_files(source, language, inventory, excluded,
                                            unsafe_source_path, SECRETS, title)
    validate_payload(payload, language)
    if not payload:
        fail('No archiveable solution source found.')
    manifest = {
        'schema': 3,
        'mode': 'source-only',
        'language': language,
        'directory_name': directory_name,
        'project_id': pid,
        'completion': completion,
        'files': {name: digest(raw) for name, raw in sorted(payload.items())},
    }
    readme = (f'# {title}\n\n'
              f'Source-only archive for Hyperskill Project {pid}.\n\n'
              f'Language: {language.title()}  \n'
              f'Project: https://hyperskill.org/projects/{pid}\n').encode('utf-8')
    payload[MANIFEST] = (json.dumps(manifest, indent=2, ensure_ascii=False) + '\n').encode('utf-8')
    payload['README.md'] = readme

    print(f'Project ID: {pid}; title: {title!r}; language: {language}')
    print(f'Owner completion: {args.completed_at}')
    print(f'Final source folder: {code_root}')
    print(f'Target: {target}')
    print(f'Academy inventory checked: {len(academy_paths)} paths; archived members: {len(manifest["files"])}')
    for name, raw in sorted(payload.items()):
        print(f'EXPORT {name} ({len(raw)} bytes; sha256 {digest(raw)})')
    git('diff', '--check')
    if args.dry_run:
        print('DRY-RUN OK: no files written; no Academy build or solution code was executed.')
        return

    with (REPO / '.import-hyperskill.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if target.exists() or git('ls-tree', 'HEAD', '--', target.relative_to(REPO).as_posix()).stdout:
            fail('Destination appeared during import; no files written.')
        target.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='.import-', dir=target.parent) as temporary:
            stage = Path(temporary) / directory_name
            for name, raw in payload.items():
                path = stage / name
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(raw)
            validate_payload({name: stage.joinpath(*Path(name).parts).read_bytes()
                              for name in manifest['files']}, language)
            validate_source_only_export(stage, manifest)
            if any((stage / name).read_bytes() != raw for name, raw in payload.items()):
                fail('Staged archive differs from source inventory.')
            stage.rename(target)
    git('diff', '--check')
    print('IMPORT OK: source-only archive written; no builds, tests, or student code were executed.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('source', help='original Academy workspace directory')
    parser.add_argument('language', nargs='?', choices=('auto', 'java', 'python'), default='auto')
    parser.add_argument('--repository', type=Path, help='isolated export checkout')
    parser.add_argument('--project-url')
    parser.add_argument('--completed-at', help='actual owner completion time in UTC; never generated')
    parser.add_argument('--title', help='use only when course-info.yaml has no unique title')
    parser.add_argument('--dry-run', action='store_true', help='read-only source/archive review')
    args = parser.parse_args()
    global REPO
    try:
        if args.repository:
            REPO = args.repository.resolve(strict=True)
        execute(args)
    except (ValueError, OSError, subprocess.CalledProcessError, KeyError) as error:
        print('STOP: ' + str(error), file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
