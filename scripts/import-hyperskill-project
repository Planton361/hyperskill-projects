#!/usr/bin/env python3
"""Read-only Academy source -> conservative, independently buildable export."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import urlsplit

REPO = Path(__file__).resolve().parent.parent
TEMPLATES = REPO / "scripts/templates"
MANIFEST = ".hyperskill-import.json"
BLOCKED = {".git", ".idea", ".gradle", "build", "target", "out",
           "frameworkLessonHistory", ".hyperskill", ".education", "__pycache__"}
PLATFORM = re.compile(r"hyperskill\.hstest|org\.hyperskill|StageTest\s*[<{]|CheckResult\.")
SECRETS = re.compile(
    r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|"
    r"\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[A-Z0-9]{16})\b|"
    r"(?i:(?:password|passwd|api[_-]?key|access[_-]?token|secret)\s*[=:]\s*[\"'][^\"'\n]{4,}[\"'])"
)
BUILD_NAMES = {"build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts",
               "pom.xml", "gradle.properties", "libs.versions.toml"}
WRAPPER = ("gradlew", "gradlew.bat", "gradle/wrapper/gradle-wrapper.jar",
           "gradle/wrapper/gradle-wrapper.properties")


def fail(message):
    raise ValueError(message)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def inventory(root):
    """Never follow links; include empty directories and every file in dry-runs."""
    entries = []
    for parent, dirs, files in os.walk(root, followlinks=False):
        dirs.sort()
        files.sort()
        for name in dirs + files:
            path = Path(parent) / name
            entries.append(path.relative_to(root))
    return sorted(entries)


def excluded(path):
    for part in path.parts:
        if part in BLOCKED or part.startswith(".author_contents_storage_db"):
            return "IDE/Git/Build/Cache/Verlauf"
    name = path.name
    if name == "task.html" or name.endswith("-info.yaml"):
        return "Hyperskill-Metadaten/Aufgabenstellung"
    if name.endswith((".tmp", ".swp", ".bak", ".log", ".class", "~")):
        return "temporäre/generierte Datei"
    if "test" in path.parts or "tests" in path.parts:
        return "Tests (keine Plattformtests importieren)"
    return None


def git(*args, capture=False):
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0")
    return subprocess.run(["git", "-C", str(REPO), *args], check=True,
                          text=True, capture_output=capture, env=env)


def analyze(source, args):
    entries = inventory(source)
    candidates = [p for p in entries if p.parts[-2:] == ("task", "src")
                  and len(p.parts) == 3 and (source / p).is_dir()
                  and not excluded(p)]
    if len(candidates) != 1:
        fail("Erwartet genau <lesson>/task/src; gefunden: " + repr(candidates))
    src = candidates[0]
    task = src.parent
    lesson = task.parent
    print(f"Finaler Quellordner: {src}")
    profile = json.loads((TEMPLATES / "academy-profile.json").read_text())
    issues = []
    for name, sha in profile["files"].items():
        path = source / name
        if not path.is_file() or path.is_symlink() or digest(path.read_bytes()) != sha:
            issues.append(f"{name}: unbekanntes Buildprofil; Plugins, Abhängigkeiten, "
                          "Java-Konfiguration und Source Sets manuell prüfen")
        print(f"Buildanalyse: {name} (wird nicht ausgeführt oder kopiert)")

    accepted = {}
    texts = {}
    for rel in entries:
        path = source / rel
        reason = excluded(rel)
        if path.is_symlink():
            reason = "Symlink wird nicht verfolgt"
            if not excluded(rel):
                issues.append(f"Symlink im relevanten Bereich: {rel}")
        if not path.is_dir() and not path.is_file() and not path.is_symlink():
            issues.append(f"Spezialdatei: {rel}")
        if reason:
            print(f"IGNORE {str(rel)!r}: {reason}")
            continue
        if rel.is_relative_to(src):
            if path.is_dir():
                continue
            if path.suffix != ".java" or path.name == "module-info.java":
                issues.append(f"Ressource/ungewöhnliches Quelllayout: {rel}")
            else:
                data = path.read_bytes()
                text = data.decode("utf-8")
                if PLATFORM.search(text):
                    issues.append(f"Plattformcode im Quellordner: {rel}")
                if SECRETS.search(text):
                    issues.append(f"Mögliches Secret in {rel} (Inhalt nicht ausgegeben)")
                imports = re.findall(r"\bimport\s+(?:static\s+)?([\w.]+)", text)
                if any(not i.startswith(("java.", "javax.")) for i in imports):
                    issues.append(f"Nicht-JDK-Imports/zusätzliche Abhängigkeiten: {rel}")
                if re.search(r"jdbc:|java\.sql|javax\.sql|javax\.persistence|"
                             r"javax\.servlet|org\.springframework|Class\.forName|"
                             r"getResource|\bFiles\.|\bPaths\.|\bFile(?:InputStream|Reader)?\s*\(", text):
                    issues.append(f"Datenbank/Framework/Datei- oder Ressourcenzugriff: {rel}")
                dest = Path("src/main/java") / rel.relative_to(src)
                accepted[dest.as_posix()] = data
                texts[rel] = text
                print(f"COPY   {str(rel)!r} -> {dest.as_posix()!r}")
            continue
        if path.is_dir():
            if rel.is_relative_to(task) and rel != task:
                issues.append(f"Zusätzliches Verzeichnis/Ressourcen: {rel}")
            continue
        if rel.parts[0] == "util":
            issues.append(f"Nichtleeres util-Modul: {rel}")
        elif rel.name in BUILD_NAMES and str(rel) not in profile["files"]:
            issues.append(f"Zusätzliche relevante Builddatei: {rel}; manuelle Analyse nötig")
        elif rel.is_relative_to(lesson) and not rel.is_relative_to(task):
            pass  # Earlier Academy stages are deliberately never imported.
        elif str(rel) not in {*profile["files"], *WRAPPER, "README.md", ".gitignore"}:
            issues.append(f"Unbekannte Datei/Ressource außerhalb des finalen Java-Codes: {rel}")
        print(f"IGNORE {str(rel)!r}: nicht auf der Positivliste (Build/Stage/sonstige Datei)")

    if not accepted:
        issues.append("Kein Java-Quellcode gefunden")
    if issues:
        fail("Automatischer Minimal-Build abgelehnt:\n- " + "\n- ".join(issues))
    return accepted, texts


def java_version(source, texts, explicit):
    buildtext = "\n".join((source / n).read_text() for n in ("build.gradle", "settings.gradle"))
    versions = set(map(int, re.findall(
        r"(?:JavaLanguageVersion\.of\(|options\.release\s*=\s*|options\.release\.set\()\s*(\d+)", buildtext)))
    versions.update(map(int, re.findall(r"JavaVersion\.VERSION_(\d+)", buildtext)))
    combined = "\n".join(texts.values())
    minimum = 8
    if '"""' in combined:
        minimum = max(minimum, 15)
    if re.search(r"\brecord\s+\w+\s*\(", combined):
        minimum = max(minimum, 16)
    if re.search(r"\bsealed\s+(?:class|interface)", combined):
        minimum = max(minimum, 17)
    course = source / "course-info.yaml"
    metadata = re.search(r"programming_language_version:\s*(\d+)", course.read_text()) if course.exists() else None
    print(f"Java-Analyse: explizite Buildversionen={sorted(versions)}, "
          f"Kursangabe={metadata[1] if metadata else 'unbekannt'}, "
          f"erkannte Syntax-Untergrenze={minimum} (Heuristik, kein Compiler)")
    chosen = explicit or (next(iter(versions)) if len(versions) == 1 else None)
    if chosen is None:
        fail("WARNUNG: Java-Zielversion nicht eindeutig. Bitte --java-version N angeben.")
    if chosen < minimum:
        fail(f"Java {chosen} liegt unter der erkannten Syntax-Untergrenze {minimum}.")
    if explicit and versions and versions != {explicit}:
        print(f"WARNUNG: Explizites Java {explicit} überschreibt Buildhinweise {sorted(versions)}.")
    print(f"Java-Zielversion: {chosen}; tatsächlicher Build muss separat getestet werden.")
    return chosen


def main_class(texts, explicit):
    found = []
    for path, text in texts.items():
        if re.search(r"public\s+static\s+void\s+main\s*\(\s*String(?:\s*\[\s*\]|\s*\.\.\.)", text):
            package = re.search(r"(?m)^\s*package\s+([\w.]+)\s*;", text)
            found.append((package[1] + "." if package else "") + path.stem)
    if explicit:
        if explicit not in found:
            fail("--main-class stimmt mit keinem erkannten Einstiegspunkt überein")
        return explicit
    if len(found) != 1:
        fail(f"Main-Klasse nicht eindeutig: {found}; bitte --main-class angeben")
    return found[0]


def validate(payload):
    for name, data in payload.items():
        path = Path(name)
        if path.is_absolute() or ".." in path.parts or excluded(path):
            fail(f"Verbotener Zielpfad: {name}")
        if name.endswith(".jar"):
            if name != "gradle/wrapper/gradle-wrapper.jar":
                fail(f"Unerwartete Binärdatei: {name}")
            continue
        text = data.decode("utf-8")
        if PLATFORM.search(text) or SECRETS.search(text):
            fail(f"Plattformcode oder mögliches Secret in {name}")
        if any(line.rstrip(" \t") != line for line in text.splitlines()):
            fail(f"Whitespace-Fehler in {name}; Quelldatei wird nicht automatisch geändert")
        if re.search(r"(?m)^(?:<{7}|={7}|>{7})(?: |$)", text):
            fail(f"Möglicher Mergekonflikt in {name}")


def check_existing(target, payload, update):
    if not target.exists():
        return
    if not update:
        fail("Ziel existiert bereits; Änderungen erfordern --update")
    entries = inventory(target)
    for rel in entries:
        if (target / rel).is_symlink() or excluded(rel):
            fail(f"Update abgelehnt: unerwarteter/verbotener Zielinhalt {rel}")
    marker = target / MANIFEST
    if not marker.is_file():
        fail("Update ohne gültiges Importmanifest abgelehnt")
    old = json.loads(marker.read_text())["files"]
    actual = {str(p) for p in entries if (target / p).is_file()} - {MANIFEST}
    if actual != set(old) or not set(old).issubset(payload):
        fail("Dateien fehlen, wurden ergänzt oder müssten gelöscht werden; manuelle Prüfung nötig")
    for name, sha in old.items():
        if digest((target / name).read_bytes()) != sha:
            fail(f"Lokale Änderung geschützt: {name}")


def execute(args):
    source = Path(args.source).resolve(strict=True)
    if not source.is_dir() or source == REPO or source.is_relative_to(REPO) or REPO.is_relative_to(source):
        fail("Quelle und Repository müssen getrennte, nicht ineinander liegende Verzeichnisse sein")
    if args.language != "java":
        fail("Version 1 unterstützt nur einfache Java-Projekte; andere Sprachen benötigen einen geprüften Adapter")
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", args.project_name):
        fail("Projektname muss ein einfacher lowercase-kebab-case Name sein")
    target = REPO / args.language / args.project_name
    if target.parent.is_symlink() or target.is_symlink():
        fail("Ziel darf kein Symlink sein")
    if git("rev-parse", "--show-toplevel", capture=True).stdout.strip() != str(REPO):
        fail("Importer muss in einem eigenständigen Repository liegen")
    payload, texts = analyze(source, args)
    version = java_version(source, texts, args.java_version)
    main = main_class(texts, args.main_class)
    for name in ("build.gradle.kts", "settings.gradle.kts"):
        content = (TEMPLATES / "java-gradle" / (name + ".in")).read_text()
        for key, value in {"JAVA_VERSION": str(version), "MAIN_CLASS": main,
                           "PROJECT_NAME": args.project_name}.items():
            content = content.replace("@" + key + "@", value)
        payload[name] = content.encode()
    checksums = json.loads((TEMPLATES / "wrapper-sha256.json").read_text())
    for name in WRAPPER:
        data = (TEMPLATES / "wrapper" / name).read_bytes()
        if digest(data) != checksums[name]:
            fail(f"Wrapper-Prüfsumme falsch: {name}")
        payload[name] = data
    title = args.title or args.project_name.replace("-", " ").title()
    for field in (title, args.concepts):
        if any(ord(char) < 32 for char in field):
            fail("README-Felder dürfen keine Steuerzeichen enthalten")
    url = args.project_url
    if url and (urlsplit(url).scheme != "https" or urlsplit(url).netloc != "hyperskill.org"
                or not re.fullmatch(r"/projects/\d+/?", urlsplit(url).path)
                or urlsplit(url).query or urlsplit(url).fragment):
        fail("Projektlink muss https://hyperskill.org/projects/NUMMER sein")
    payload["README.md"] = (
        f"# {title}\n\nSprache: Java {version}\n\nKonzepte: {args.concepts}\n\n"
        f"Build: `./gradlew build`\n\nStart: `./gradlew run`\n\n"
        f"Voraussetzung: JDK {max(17, version)} oder neuer für Gradle; Java-Zielversion {version}.\n"
        + (f"\nHyperskill: {url}\n" if url else "")
    ).encode()
    validate(payload)
    check_existing(target, payload, args.update)
    manifest = {"schema": 1, "language": "java", "java_version": version,
                "files": {name: digest(data) for name, data in sorted(payload.items())}}
    payload[MANIFEST] = (json.dumps(manifest, indent=2) + "\n").encode()
    print(f"\nZiel: {target}")
    for name in sorted(payload):
        print(f"RESULT {name}")
    git("diff", "--check")
    git("status", "--short")
    if args.dry_run:
        print("DRY-RUN OK: keine Dateien geschrieben; keine Builds ausgeführt.")
        return
    # Serialize imports; recheck existing content after obtaining the lock.
    with (REPO / ".import-hyperskill.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        check_existing(target, {k: v for k, v in payload.items() if k != MANIFEST}, args.update)
        target.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".import-", dir=target.parent) as temporary:
            stage = Path(temporary) / "project"
            for name, data in payload.items():
                path = stage / name
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(data)
            (stage / "gradlew").chmod(0o755)
            validate({name: (stage / name).read_bytes() for name in payload})
            if target.exists():
                # All old paths are retained. No source/target files are deleted.
                for name in payload:
                    dest = target / name
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    os.replace(stage / name, dest)
            else:
                stage.rename(target)
    git("diff", "--check")
    git("status", "--short", "--untracked-files=all")
    print("IMPORT OK; Build/Run jetzt separat im Ziel ausführen. Kein Commit/Push.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source")
    parser.add_argument("language")
    parser.add_argument("project_name")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--update", action="store_true")
    parser.add_argument("--java-version", type=int)
    parser.add_argument("--main-class")
    parser.add_argument("--title")
    parser.add_argument("--concepts", default="Konsolenein-/ausgabe, Kontrollfluss und Methoden")
    parser.add_argument("--project-url")
    args = parser.parse_args()
    try:
        if args.java_version is not None and not 8 <= args.java_version <= 99:
            fail("Ungültige Java-Version")
        execute(args)
    except (ValueError, OSError, subprocess.CalledProcessError, KeyError) as error:
        print(f"ABBRUCH: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
