#!/usr/bin/env python3
"""Owner-reviewed publication of one new Java export; Academy source stays read-only."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys
import tempfile
import uuid

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parents[1]
IMPORTER = ROOT / 'scripts/import-hyperskill-project'
REPOSITORY = 'Planton361/hyperskill-projects'


def git(*args, env=None, capture=True, text=True):
    return subprocess.run(['git', '--literal-pathspecs', '-C', str(ROOT), *args],
                          check=True, text=text, capture_output=capture, env=env)


def require(condition, message):
    if not condition:
        raise ValueError(message)


def confirm(prompt, expected):
    require(input(prompt + '\nType ' + expected + ': ').strip() == expected,
            'Owner declined; nothing was published.')


def source_snapshot(source, importer):
    result = {}
    for relative in importer['inventory'](source):
        path = source / relative
        result[str(relative)] = ('link', os.readlink(path)) if path.is_symlink() else (
            ('file', hashlib.sha256(path.read_bytes()).hexdigest(), path.stat().st_mode)
            if path.is_file() else ('directory', path.stat().st_mode))
    return result


def duplicate_check(pid):
    # This repository now contains independent exports, not Atlas catalogs.
    # Validate explicit IDs and protected bytes in both committed and local
    # manifests. Topic mapping remains MyAtlas's committed scanner's authority.
    from export_metadata import validate_completion
    committed = git('ls-tree', '-r', '--name-only', '-z', 'HEAD', '--', 'java').stdout.split('\0')
    markers = [n for n in committed if n.endswith('/.hyperskill-import.json')]
    local = [p.relative_to(ROOT).as_posix() for p in ROOT.glob('java/*/.hyperskill-import.json')]
    for name, tracked in [(n, True) for n in markers] + [(n, False) for n in local]:
        def read(relative):
            if tracked:
                return git('show', 'HEAD:' + relative, text=False).stdout
            path = ROOT / relative
            require(not path.is_symlink() and path.resolve().is_relative_to(ROOT),
                    'Unsafe existing export path; request manual review.')
            return path.read_bytes()
        meta = json.loads(read(name))
        require(meta.get('schema') == 2 and meta.get('language') == 'java' and
                isinstance(meta.get('files'), dict) and meta['files'],
                'Invalid existing export manifest; request manual review.')
        directory = str(Path(name).parent)
        for relative, digest in meta['files'].items():
            path = Path(relative)
            require(not path.is_absolute() and '..' not in path.parts and
                    isinstance(digest, str) and re.fullmatch(r'[a-f0-9]{64}', digest),
                    'Invalid existing export inventory; request manual review.')
            require(hashlib.sha256(read(directory + '/' + relative)).hexdigest() == digest,
                    'Existing export evidence is invalid; request manual review.')
        ids = {int(n) for n in re.findall(r'https://hyperskill\.org/projects/([1-9][0-9]*)(?![0-9])',
                                        read(directory + '/README.md').decode())}
        completion = meta.get('completion')
        if completion:
            validate_completion(completion)
            ids.add(completion['project_id'])
        if 'project_id' in meta:
            require(type(meta['project_id']) is int and meta['project_id'] > 0,
                    'Invalid explicit Project ID; request manual review.')
            ids.add(meta['project_id'])
        require(len(ids) == 1, 'Missing or conflicting explicit Project IDs; request manual review.')
        require(pid not in ids, 'Duplicate Project ID export; request manual adapter/update review.')


def execute(args):
    require(args.attest_completed, 'Explicit --attest-completed owner attestation is required.')
    require(re.fullmatch(r'https://hyperskill\.org/projects/[1-9][0-9]*/?', args.project_url),
            'Supply the exact HTTPS Hyperskill Project URL, without query or fragment.')
    require(re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,6})?Z', args.completed_at),
            'Supply the actual UTC completion timestamp ending in Z; it is never generated.')
    stamp = datetime.fromisoformat(args.completed_at.replace('Z', '+00:00'))
    require(stamp <= datetime.now(timezone.utc), 'Completion timestamp must not be in the future.')
    source = Path(args.source).resolve(strict=True)
    importer = runpy.run_path(str(IMPORTER))
    # Importer remains the sole authority for supported layouts, secrets,
    # source allowlists, Java selection, wrapper checks and manifest format.
    command = [sys.executable, '-B', str(IMPORTER), str(source), 'java',
               '--project-url', args.project_url, '--completed-at', args.completed_at]
    for key in ('java_version', 'title', 'main_class'):
        if getattr(args, key) is not None:
            command += ['--' + key.replace('_', '-'), str(getattr(args, key))]
    before = source_snapshot(source, importer)
    subprocess.run(command + ['--dry-run'], check=True)
    require(source_snapshot(source, importer) == before, 'Academy source changed during inspection; stop and review.')
    pid = int(args.project_url.rstrip('/').split('/')[-1])
    duplicate_check(pid)
    title = importer['title_from_source'](source, args.title)
    target = ROOT / 'java' / importer['safe_directory_name'](title)
    relative = target.relative_to(ROOT).as_posix()
    require(not target.exists(), 'New exports only; existing destinations require manual update review.')
    require(not git('ls-tree', 'HEAD', '--', relative).stdout, 'Destination exists in Git; restore/review it manually.')
    print(f'Owner attestation: Project {pid}, completed at {args.completed_at}; export {relative}', flush=True)
    if args.dry_run:
        print('REVIEW ONLY: no import, build, staging, commit or push.')
        return
    head = git('rev-parse', 'HEAD').stdout.strip()
    require(git('branch', '--show-current').stdout.strip() == 'main', 'Start on main; unrelated branch commits must not be published.')
    origin = git('remote', 'get-url', 'origin').stdout.strip().removesuffix('.git')
    require(origin in ('https://github.com/' + REPOSITORY, 'git@github.com:' + REPOSITORY), 'Unexpected origin repository.')
    remote_head = git('ls-remote', 'origin', 'refs/heads/main').stdout.split()
    require(remote_head and remote_head[0] == head, 'Local main differs from remote main; update it safely before publishing.')
    confirm('Confirm that you personally completed this project at the stated actual UTC time.', f'COMPLETE {pid}')
    subprocess.run(command, check=True)
    require(source_snapshot(source, importer) == before, 'Academy source changed during import; no publication.')
    manifest = json.loads((target / '.hyperskill-import.json').read_text())
    files = sorted([relative + '/' + n for n in manifest['files']] + [relative + '/README.md', relative + '/.hyperskill-import.json'])
    payload = {name: (ROOT / name).read_bytes() for name in files}
    with tempfile.TemporaryDirectory(prefix='hyperskill-publish-review-') as temporary:
        # Build only the independent, validated export, never the Academy tree.
        subprocess.run([str(target / 'gradlew'), '--no-daemon', '--project-cache-dir',
                        str(Path(temporary) / 'gradle-cache'), 'build'], cwd=target, check=True)
        require(source_snapshot(source, importer) == before, 'Academy source changed; no publication.')
        require(all((ROOT / n).read_bytes() == b for n, b in payload.items()), 'Export changed during build; review manually.')
        # The review index is isolated from every staged user change.
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(temporary) / 'review-index'))
        git('read-tree', head, env=env)
        git('add', '--', *files, env=env)
        require(all(git('show', ':' + n, env=env, text=False).stdout == data for n, data in payload.items()),
                'Git filters would change validated export bytes; review attributes/configuration manually.')
        staged = git('diff', '--cached', '--name-only', '-z', head, env=env).stdout.split('\0')
        require(sorted(n for n in staged if n) == files, 'Review contains unexpected Git changes.')
        git('-c', 'core.whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol', 'diff', '--cached', '--check', head, env=env)
        git('diff', '--cached', '--stat', head, env=env, capture=False)
        git('diff', '--cached', '--no-ext-diff', head, env=env, capture=False)
        if args.prepare_only:
            print(f'READY FOR OWNER REVIEW: built export at {target}; real Git index and HEAD unchanged.')
            return
        confirm(f'Review the exact export above. Commit it and publish via {args.publish}?', f'PUBLISH {pid}')
        require(git('rev-parse', 'HEAD').stdout.strip() == head, 'HEAD changed during review; restart safely.')
        require(all((ROOT / n).read_bytes() == b for n, b in payload.items()), 'Export changed during review; no publication.')
        # Refresh the reviewed index to catch changed executable bits as well.
        tree = git('write-tree', env=env).stdout.strip()
        git('add', '--', *files, env=env)
        require(git('write-tree', env=env).stdout.strip() == tree, 'Export modes/content changed during review.')
        branch = 'publish/hyperskill-' + str(pid) + '-' + uuid.uuid4().hex[:8]
        if args.publish == 'pr':
            git('switch', '-c', branch, capture=False)
        # Git --only ignores unrelated staged paths, even when they preexist.
        git('add', '--', *files)
        git('commit', '--only', '-m', f'Publish owner-attested Hyperskill Project {pid}: {title}', '--', *files, capture=False)
        require(git('rev-parse', 'HEAD^{tree}').stdout.strip() == tree,
                'Commit differs from reviewed export; no push. Inspect hooks/changes manually.')
        destination = 'main' if args.publish == 'push' else branch
        try:
            git('push', 'origin', 'HEAD:refs/heads/' + destination, capture=False)
        except subprocess.CalledProcessError:
            raise ValueError('Push rejected; commit retained locally. No force push or retry. Review repository rules and publish the reviewed commit through a PR if required.')
        print('Published reviewed export to ' + REPOSITORY + ', branch ' + destination)
        if args.publish == 'pr':
            print('Open the prepared PR comparison: https://github.com/' + REPOSITORY + '/compare/main...' + branch + '?expand=1')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('source', help='original independent IntelliJ Academy project directory')
    parser.add_argument('--project-url', required=True)
    parser.add_argument('--completed-at', required=True)
    parser.add_argument('--attest-completed', action='store_true')
    parser.add_argument('--java-version', type=int)
    parser.add_argument('--title')
    parser.add_argument('--main-class')
    parser.add_argument('--dry-run', action='store_true', help='importer inspection only; no writes')
    parser.add_argument('--prepare-only', action='store_true', help='import/build/review only; no staging, commit or push')
    parser.add_argument('--publish', choices=('pr', 'push'), default='pr', help='default: isolated export branch and PR comparison; push: normal fast-forward main push')
    args = parser.parse_args()
    try:
        execute(args)
    except (ValueError, OSError, subprocess.CalledProcessError, EOFError) as error:
        print('STOP: ' + str(error) + '\nNo further publication. Unsupported layouts need manual adapter review; validation is never bypassed.', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
